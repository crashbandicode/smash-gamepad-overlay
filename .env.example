# Optional local emulator deployment settings.
# Copy to .env and adjust paths for your machine. .env is gitignored.

# SD card root used by tools/sgpo_installer. For an emulator this is usually
# the `sdmc` directory.
SGPO_SD_ROOT=/path/to/emulator/user/sdmc

# Set to 1 to make tools/stage_arcropolis_layout.py copy to the emulator paths.
SGPO_DEPLOY_EMU=0

# Skyline plugin folder in the emulator SD card.
SGPO_EMU_PLUGIN_DIR=/path/to/emulator/user/sdmc/atmosphere/contents/01006A800016E000/romfs/skyline/plugins

# ARCropolis mods folder in the emulator SD card.
SGPO_EMU_MODS_DIR=/path/to/emulator/user/sdmc/ultimate/mods

# Optional log path for quick local reference.
SGPO_EMU_LOG_PATH=/path/to/emulator/user/sdmc/smash-gamepad-overlay.log

# Optional toolbox-cli binary path used only by legacy Python layout builders.
# The Rust installer links nx-layout-toolbox from local-checkouts/Toolbox-Cli
# as a Cargo path dependency until the toolbox crate is published.
TOOLBOX_CLI=/path/to/toolbox-cli

# Optional defaults used by tools/sgpo_installer.
# Preferred release input: a user-owned Smash data.arc dump. If set, the
# installer extracts and patches info_melee/layout.arc into ignored local output.
SGPO_DATA_ARC=/path/to/Smash/data.arc

# Alternative input if you already extracted ui/layout/info/info_melee/info_melee/layout.arc.
SGPO_INFO_MELEE_LAYOUT_ARC=/path/to/info_melee/layout.arc

# Ignored work directory used for data.arc/layout.arc extraction and default
# square-pane patching.
SGPO_BASE_WORK_DIR=local-assets/generated/base-info-melee

# Optional pre-unpacked, already patched base layout. If SGPO_DATA_ARC or
# SGPO_INFO_MELEE_LAYOUT_ARC is set, this is not required.
SGPO_BASE_UNPACKED=local-assets/modified/info_melee/unpacked
SGPO_SKIN_OUTPUT_DIR=local-assets/generated/sgpo-skins
SGPO_NRO=target/aarch64-skyline-switch/release/libsmash_gamepad_overlay.nro

# Optional default skin directory used by tools/analyze_retrospy_skin.py when
# --skin-dir is not passed on the command line. Should point at a RetroSpy
# skins/<skin-name>/ folder containing skin.xml + PNG assets.
SGPO_RETROSPY_SKIN_DIR=/path/to/RetroSpy/skins/switch-pro-alt

# Optional preset skin directories used by tools/sgpo_installer.
SGPO_SWITCH_PRO_ALT_DIR=/path/to/RetroSpy/skins/switch-pro-alt
SGPO_GAMECUBE_TRON_DIR=/path/to/RetroSpy/skins/gamecube-tron
