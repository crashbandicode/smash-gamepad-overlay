# Optional local emulator deployment settings.
# Copy to .env and adjust paths for your machine. .env is gitignored.

# Set to 1 to make tools/stage_arcropolis_layout.py copy to the emulator paths.
SGPO_DEPLOY_EMU=0

# Skyline plugin folder in the emulator SD card.
SGPO_EMU_PLUGIN_DIR=/path/to/emulator/user/sdmc/atmosphere/contents/01006A800016E000/romfs/skyline/plugins

# ARCropolis mods folder in the emulator SD card.
SGPO_EMU_MODS_DIR=/path/to/emulator/user/sdmc/ultimate/mods

# Optional log path for quick local reference.
SGPO_EMU_LOG_PATH=/path/to/emulator/user/sdmc/smash-gamepad-overlay.log

# Optional default skin directory used by tools/analyze_retrospy_skin.py when
# --skin-dir is not passed on the command line. Should point at a RetroSpy
# skins/<skin-name>/ folder containing skin.xml + PNG assets.
SGPO_RETROSPY_SKIN_DIR=/path/to/RetroSpy/skins/switch-pro-alt
